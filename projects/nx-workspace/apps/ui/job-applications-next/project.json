{
  "name": "job-applications-next",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ui/job-applications-next",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^default",
        { "externalDependencies": ["next"] },
        { "dependentTasksOutputFiles": "**/*.d.ts", "transitive": true }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/ui/job-applications-next/.next/!(cache)/**/*",
        "{workspaceRoot}/dist/apps/ui/job-applications-next/.next/!(cache)",
        "{workspaceRoot}/dist/apps/ui/job-applications-next/skill-workdir"
      ],
      "options": {
        "cwd": "apps/ui/job-applications-next",
        "tty": false,
        "commands": [
          "next build --webpack",
          "node scripts/build-skill-scripts.mjs"
        ],
        "parallel": false
      },
      "configurations": {
        "development": {}
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ui/job-applications-next",
        "command": "next dev --webpack --hostname 127.0.0.1 --port 3000"
      }
    },
    "docker:up": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "docker compose -f apps/ui/job-applications-next/docker-compose.yml up -d --build"
      },
      "configurations": {
        "repo-files": {
          "command": "docker compose -f apps/ui/job-applications-next/docker-compose.yml -f apps/ui/job-applications-next/docker-compose.repo-files.yml up -d --build"
        }
      }
    },
    "docker:down": {
      "command": "docker compose -f apps/ui/job-applications-next/docker-compose.yml down"
    },
    "docker:logs": {
      "command": "docker compose -f apps/ui/job-applications-next/docker-compose.yml logs -f"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
