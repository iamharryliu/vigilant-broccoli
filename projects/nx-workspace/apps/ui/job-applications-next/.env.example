# Copy to .env next to docker-compose.yml.

# From `claude setup-token`; runs bill your Claude subscription. Export it in
# the shell that starts the container instead of saving it here.
CLAUDE_CODE_OAUTH_TOKEN=

# Claude model for runs: an alias such as opus or a full model ID (default:
# sonnet).
JOB_APPLICATIONS_MODEL=

# Pages allowed to embed the app in an iframe, as CSP sources (default:
# 'self'), e.g. 'self' https://manager.example.com
JOB_APPLICATIONS_FRAME_ANCESTORS=

# Host folder for application folders (default: ~/Desktop/Job Applications).
JOB_APPLICATIONS_DIR=

# Host folder holding career-experience.md and resume.json. Leave empty to
# start from the sample profile kept in a Docker volume and edited in the app.
CAREER_DIR=

# Host port for http://localhost:<port> (default: 4300).
JOB_APPLICATIONS_PORT=
