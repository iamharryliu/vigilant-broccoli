# Supabase. Deliberately unprefixed (no NEXT_PUBLIC_) — the client fetches
# these from /api/config at runtime instead of reading process.env
# directly, so this Docker image isn't locked to one Supabase project at
# build time. See libs/supabase.ts.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Upstream employee-handler service. If unset, the UI's /api/* routes fall
# back to running the bundled EMPLOYEE_HANDLER_CONFIG_MOCK in-process. If set,
# every /api/* request is proxied to ${EMPLOYEE_HANDLER_URL}${pathname}.
# optional
EMPLOYEE_HANDLER_URL=

# Comma-separated emails and domains allowed to call the API after sign-in.
# With both unset, any user who can sign in to the Supabase project is allowed.
# optional
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# Skips sign-in and serves the bundled mock to anonymous visitors. Ignored
# when EMPLOYEE_HANDLER_URL is set. Only the demo Vercel deploy sets it.
# optional
DEMO_MODE=
