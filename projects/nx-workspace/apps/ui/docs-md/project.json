{
  "name": "docs-md",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ui/docs-md/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build-snapshot": {
      "command": "node scripts/build-docs-snapshot.mjs apps/ui/docs-md/snapshot.config.json"
    },
    "build": {
      "dependsOn": ["^build", "build-snapshot"],
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/docs-md"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../../dist/docs-md"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "ensure-cf-project": {
      "command": "npx wrangler pages project list 2>&1 | grep -qw staging-docs-md || npx wrangler pages project create staging-docs-md --production-branch main"
    },
    "prune-deployments": {
      "command": "npx tsx scripts/prune-wrangler-deployments.ts staging-docs-md 10",
      "dependsOn": ["ensure-cf-project"]
    },
    "deploy": {
      "command": "npx wrangler pages deploy dist/docs-md --project-name staging-docs-md --branch main",
      "dependsOn": ["build", "ensure-cf-project", "prune-deployments"]
    },
    "manual-deploy": {
      "command": "npx wrangler pages deploy dist/docs-md --project-name staging-docs-md --branch main",
      "dependsOn": ["build", "ensure-cf-project", "prune-deployments"]
    },
    "ensure-cf-project:production": {
      "command": "npx wrangler pages project list 2>&1 | grep -qw production-docs-md || npx wrangler pages project create production-docs-md --production-branch production"
    },
    "prune-deployments:production": {
      "command": "npx tsx scripts/prune-wrangler-deployments.ts production-docs-md 10",
      "dependsOn": ["ensure-cf-project:production"]
    },
    "deploy:production": {
      "command": "npx wrangler pages deploy dist/docs-md --project-name production-docs-md --branch production",
      "dependsOn": [
        "build",
        "ensure-cf-project:production",
        "prune-deployments:production"
      ]
    }
  }
}
