{
  "name": "local-manager-next",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ui/local-manager-next",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "NEXT_PUBLIC_SOCKET_SERVER_URL=https://socket.harryliu.dev nx run local-manager-next:build:next"
      }
    },
    "build:next": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^default",
        { "externalDependencies": ["next"] },
        { "dependentTasksOutputFiles": "**/*.d.ts", "transitive": true },
        { "env": "NEXT_PUBLIC_SUPABASE_URL" },
        { "env": "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY" },
        { "env": "NEXT_PUBLIC_SOCKET_SERVER_URL" }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/ui/local-manager-next/.next/!(cache)/**/*",
        "{workspaceRoot}/dist/apps/ui/local-manager-next/.next/!(cache)"
      ],
      "options": {
        "cwd": "apps/ui/local-manager-next",
        "tty": false,
        "command": "next build --webpack"
      },
      "configurations": {
        "development": {}
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "env -u GITHUB_TOKEN NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt node --import tsx scripts/fetch-secrets.ts --env-file apps/ui/local-manager-next/.env.local.example --env-file scripts/.env.scripts.example --map SOCKET_SERVER_URL:NEXT_PUBLIC_SOCKET_SERVER_URL 'node --import tsx scripts/migrate.ts --migrations-dir=apps/ui/local-manager-next/supabase/migrations && cd apps/ui/local-manager-next && next dev --webpack --hostname 127.0.0.1'",
        "env": {
          "VB_EXPRESS_URL": "https://staging-vb-express.fly.dev"
        }
      }
    },
    "serve:no-vault": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "apps/ui/local-manager-next",
        "command": "env -u GITHUB_TOKEN next dev --webpack"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/ui/local-manager-next"],
      "options": {
        "jestConfig": "apps/ui/local-manager-next/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --config=apps/ui/local-manager-next/e2e/playwright.config.ts"
      }
    },
    "e2e:headed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --config=apps/ui/local-manager-next/e2e/playwright.config.ts --headed"
      }
    },
    "e2e:headed:slow": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --config=apps/ui/local-manager-next/e2e/playwright.config.ts --headed --project=slow"
      }
    },
    "pm2:start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "parallel": false,
        "commands": [
          {
            "command": "env -u GITHUB_TOKEN NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt tsx scripts/fetch-secrets.ts --env-file apps/ui/local-manager-next/.env.local.example --env-file scripts/.env.scripts.example 'node --import tsx scripts/migrate.ts --migrations-dir=apps/ui/local-manager-next/supabase/migrations && pm2 start apps/ui/local-manager-next/ecosystem.config.js'"
          },
          {
            "command": "pm2 save"
          }
        ]
      }
    },
    "pm2:reload": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "parallel": false,
        "commands": [
          {
            "command": "env -u GITHUB_TOKEN NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt tsx scripts/fetch-secrets.ts --env-file apps/ui/local-manager-next/.env.local.example --env-file scripts/.env.scripts.example 'node --import tsx scripts/migrate.ts --migrations-dir=apps/ui/local-manager-next/supabase/migrations && pm2 reload apps/ui/local-manager-next/ecosystem.config.js'"
          },
          {
            "command": "pm2 save"
          }
        ]
      }
    },
    "pm2:delete": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pm2 delete local-manager-next"
      }
    },
    "pm2:logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pm2 logs local-manager-next"
      }
    },
    "pm2:status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pm2 status"
      }
    }
  }
}
