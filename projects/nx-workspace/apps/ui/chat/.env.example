# Publisher credential for the socket server's POST /publish
SHARED_APP_TOKEN=

# Socket server (deploy-vercel.ts sets both to https://socket.harryliu.dev)
SOCKET_SERVER_URL=
NEXT_PUBLIC_SOCKET_SERVER_URL=

# Cloudflare Access assertion check. deploy-vercel.ts sets the team domain and
# reads the audience from Vault's CHAT_<ENVIRONMENT>_CF_ACCESS_AUD.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Socket room; deploy-vercel.ts sets it to the environment name
NEXT_PUBLIC_CHAT_ROOM=
