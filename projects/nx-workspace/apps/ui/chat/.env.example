# OpenAI key used by /api/chat and knowledge base search embeddings
OPENAI_API_KEY=
# vb-express, which /api/text-to-speech and /api/speech-to-text proxy to
# (deploy-vercel.ts sets VB_EXPRESS_URL per environment)
VB_EXPRESS_URL=https://staging-vb-express.fly.dev
VB_EXPRESS_API_KEY=
# Supabase service-role key for the knowledge base search (RLS has no policies)
SUPABASE_SECRET_KEY=
