# Weather API — only needed for the openweather provider; Open-Meteo (the default) needs no key
OPENWEATHER_API_KEY="OPENWEATHER_API_KEY"
# VB Express API
VB_EXPRESS_API_KEY="VB_EXPRESS_API_KEY"
VB_EXPRESS_URL="http://localhost:3333"
# OpenAI (used directly by /api/chat for function calling intent detection)
OPENAI_API_KEY="OPENAI_API_KEY"
# Stripe API
STRIPE_API_KEY="STRIPE_API_KEY"
# Socket Server (chat demo)
NEXT_PUBLIC_SOCKET_SERVER_URL="https://localhost:3443"
SOCKET_SERVER_URL="https://localhost:3443"
SHARED_APP_TOKEN="SHARED_APP_TOKEN"
# Tailscale API
TAILSCALE_API_KEY="TAILSCALE_API_KEY"
# Supabase (auth, live locations demo, notepad)
NEXT_PUBLIC_SUPABASE_URL="NEXT_PUBLIC_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="SUPABASE_SECRET_KEY"
# MongoDB (kanban board setup sync)
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net"
MONGODB_DB="vb-manager"
# Google OAuth (server-side Tasks/Calendar access-token refresh)
GOOGLE_AUTH_PROVIDER_CLIENT_ID="GOOGLE_AUTH_PROVIDER_CLIENT_ID"
GOOGLE_AUTH_PROVIDER_CLIENT_SECRET="GOOGLE_AUTH_PROVIDER_CLIENT_SECRET"
# Google Calendar service account (base64 JSON key) — owns the scraped event calendars
GOOGLE_CALENDAR_SA_CREDENTIALS="GOOGLE_CALENDAR_SA_CREDENTIALS"
# Spotify (DJ playlist download + server-side OAuth for the playlist relationship graph)
SPOTIFY_CLIENT_ID="SPOTIFY_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="SPOTIFY_CLIENT_SECRET"
# GitHub (optional, read-only) — lifts /api/preview-deployments above GitHub's 60 unauthenticated calls per hour.
# Commented out so fetch-secrets never injects it; gh CLI calls from the dev dashboard would also pick it up.
# GITHUB_TOKEN="GITHUB_TOKEN"
