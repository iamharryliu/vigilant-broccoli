{
  "name": "pages-index",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ui/pages-index/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "generate-openapi": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/generate-openapi-specs.ts",
        "{workspaceRoot}/apps/api/bucket-service/src/libs/swagger.ts",
        "{workspaceRoot}/apps/api/email-service/src/swagger.ts",
        "{workspaceRoot}/apps/api/email-subscription-service/src/swagger.ts",
        "{workspaceRoot}/apps/api/llm-service/src/libs/swagger.ts"
      ],
      "outputs": ["{projectRoot}/public/openapi"],
      "options": {
        "command": "tsx scripts/generate-openapi-specs.ts"
      }
    },
    "generate-repo-timeline": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx scripts/generate-repo-timeline.ts"
      }
    },
    "build-claude-context-snapshot": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/build-docs-snapshot.mjs apps/ui/pages-index/claude-context.snapshot.config.json"
      }
    },
    "build": {
      "dependsOn": [
        "generate-openapi",
        "generate-repo-timeline",
        "build-claude-context-snapshot"
      ],
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/pages-index"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../../dist/pages-index"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "dependsOn": [
        "generate-openapi",
        "generate-repo-timeline",
        "build-claude-context-snapshot"
      ],
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "deploy-github-pages": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "mkdir -p ../../../_site",
          "cp -R ../../../dist/pages-index/. ../../../_site/",
          "cp public/repo-timeline.json ../../../_site/repo-timeline.json",
          "cp -R public/claude-context ../../../_site/claude-context"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    }
  }
}
