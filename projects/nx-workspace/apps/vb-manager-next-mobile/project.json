{
  "name": "vb-manager-next-mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/vb-manager-next-mobile",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build", "generate-agentic-workflows"],
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["next"]
        },
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        },
        {
          "dependentTasksOutputFiles": "**/agentic-workflows.json"
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/vb-manager-next-mobile/.next/!(cache)/**/*",
        "{workspaceRoot}/dist/apps/vb-manager-next-mobile/.next/!(cache)"
      ],
      "options": {
        "cwd": "apps/vb-manager-next-mobile",
        "tty": false,
        "command": "next build --webpack"
      },
      "configurations": {
        "development": {}
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt node --import tsx scripts/fetch-secrets.ts --env-file apps/vb-manager-next-mobile/.env.example 'cd apps/vb-manager-next-mobile && next dev --webpack --port 3000'",
        "env": {
          "VB_EXPRESS_URL": "https://staging-vb-express.fly.dev"
        }
      },
      "dependsOn": ["generate-agentic-workflows"]
    },
    "serve:no-vault": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "apps/vb-manager-next-mobile",
        "command": "next dev --webpack --port 3000"
      },
      "configurations": {
        "development": {},
        "production": {}
      },
      "dependsOn": ["generate-agentic-workflows"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": ["generate-agentic-workflows"]
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "VERCEL_PROJECT_ID=staging-vb-manager-next-mobile VERCEL_ORG_ID=team_K8XGLgKfYA0WKlMX80jaVSvg NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt node --import tsx scripts/deploy-vercel.ts vb-manager-next-mobile staging"
      }
    },
    "deploy:production": {
      "executor": "nx:run-commands",
      "options": {
        "command": "VERCEL_PROJECT_ID=production-vb-manager-next-mobile VERCEL_ORG_ID=team_K8XGLgKfYA0WKlMX80jaVSvg NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt node --import tsx scripts/deploy-vercel.ts vb-manager-next-mobile production"
      }
    },
    "generate-agentic-workflows": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/generate-agentic-workflows.ts",
        {
          "runtime": "node -p \"require('crypto').createHash('sha1').update(require('fs').readFileSync('../../README.md')).digest('hex')\""
        }
      ],
      "outputs": ["{projectRoot}/src/app/generated/agentic-workflows.json"],
      "options": {
        "cwd": "apps/vb-manager-next-mobile",
        "command": "node --import tsx scripts/generate-agentic-workflows.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["generate-agentic-workflows"],
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["typescript"]
        },
        {
          "dependentTasksOutputFiles": "**/agentic-workflows.json"
        }
      ],
      "options": {
        "cwd": "apps/vb-manager-next-mobile",
        "command": "tsc --noEmit -p tsconfig.json"
      }
    }
  }
}
