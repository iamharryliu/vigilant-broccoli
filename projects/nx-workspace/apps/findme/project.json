{
  "name": "findme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/findme",
  "projectType": "application",
  "tags": ["visibility:public"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["next"]
        },
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        },
        {
          "env": "NEXT_PUBLIC_SUPABASE_URL"
        },
        {
          "env": "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
        }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/findme"],
      "options": {
        "cwd": "apps/findme",
        "tty": false,
        "command": "next build --webpack"
      },
      "configurations": {
        "development": {}
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "apps/findme",
        "command": "next dev --webpack"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "deploy": {
      "command": "npx wrangler pages deploy dist/apps/findme --project-name staging-findme --branch main",
      "dependsOn": ["build", "ensure-cf-project", "prune-deployments"]
    },
    "deploy:production": {
      "command": "npx wrangler pages deploy dist/apps/findme --project-name production-findme --branch production",
      "dependsOn": [
        "build",
        "ensure-cf-project:production",
        "prune-deployments:production"
      ]
    },
    "ensure-cf-project": {
      "command": "npx wrangler pages project list 2>&1 | grep -qw staging-findme || npx wrangler pages project create staging-findme --production-branch main"
    },
    "prune-deployments": {
      "command": "npx tsx scripts/prune-wrangler-deployments.ts staging-findme 10",
      "dependsOn": ["ensure-cf-project"]
    },
    "manual-deploy": {
      "command": "npx wrangler pages deploy dist/apps/findme --project-name staging-findme --branch main",
      "dependsOn": ["build", "ensure-cf-project", "prune-deployments"]
    },
    "ensure-cf-project:production": {
      "command": "npx wrangler pages project list 2>&1 | grep -qw production-findme || npx wrangler pages project create production-findme --production-branch production"
    },
    "prune-deployments:production": {
      "command": "npx tsx scripts/prune-wrangler-deployments.ts production-findme 10",
      "dependsOn": ["ensure-cf-project:production"]
    }
  }
}
