{
  "name": "hearth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/hearth",
  "projectType": "application",
  "tags": ["visibility:public"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "cat ../../notes/hobbies/cooking/ingredients/fruits.md ../../notes/hobbies/cooking/ingredients/vegetables.md"
        },
        { "externalDependencies": ["next"] },
        { "dependentTasksOutputFiles": "**/*.d.ts", "transitive": true }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/hearth/.next/!(cache)/**/*",
        "{workspaceRoot}/dist/apps/hearth/.next/!(cache)"
      ],
      "options": {
        "cwd": "apps/hearth",
        "tty": false,
        "command": "node --import tsx scripts/generate-in-season-produce.ts && next build --webpack"
      },
      "configurations": {
        "development": {}
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "VB_EXPRESS_URL=https://staging-vb-express.fly.dev NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt node --import tsx scripts/fetch-secrets.ts --env-file apps/hearth/.env.local.example --env-file scripts/.env.scripts.example 'node --import tsx scripts/migrate.ts --migrations-dir=apps/hearth/supabase/migrations && nx serve:local hearth'"
      }
    },
    "serve:local": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "apps/hearth",
        "command": "node --import tsx scripts/generate-in-season-produce.ts && next dev --webpack"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "generate-in-season-produce": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/generate-in-season-produce.ts",
        {
          "runtime": "cat ../../notes/hobbies/cooking/ingredients/fruits.md ../../notes/hobbies/cooking/ingredients/vegetables.md"
        }
      ],
      "outputs": ["{projectRoot}/src/lib/generated"],
      "options": {
        "cwd": "apps/hearth",
        "command": "node --import tsx scripts/generate-in-season-produce.ts"
      }
    },
    "typecheck": {
      "dependsOn": ["generate-in-season-produce"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": ["generate-in-season-produce"]
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "VERCEL_PROJECT_ID=staging-hearth VERCEL_ORG_ID=team_K8XGLgKfYA0WKlMX80jaVSvg NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt node --import tsx scripts/deploy-vercel.ts hearth staging"
      }
    },
    "deploy:production": {
      "executor": "nx:run-commands",
      "options": {
        "command": "VERCEL_PROJECT_ID=production-hearth VERCEL_ORG_ID=team_K8XGLgKfYA0WKlMX80jaVSvg NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt node --import tsx scripts/deploy-vercel.ts hearth production"
      }
    }
  }
}
