{
  "name": "llm-service",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/llm-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/dist/apps/api/llm-service"],
      "defaultConfiguration": "production",
      "configurations": {
        "development": {}
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "inputs": [
        "default",
        "{projectRoot}/package.json",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/pnpm-lock.yaml",
        "^default",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/api/llm-service/package.json",
        "{workspaceRoot}/dist/apps/api/llm-service/pnpm-lock.yaml",
        "{workspaceRoot}/dist/apps/api/llm-service/pnpm-workspace.yaml",
        "{workspaceRoot}/dist/apps/api/llm-service/patches",
        "{workspaceRoot}/dist/apps/api/llm-service/local_path_modules"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/api/llm-service/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "smoke": {
      "dependsOn": ["prune"],
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/shell/smoke-dist.sh dist/apps/api/llm-service"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt npx tsx scripts/fetch-secrets.ts 'nx serve:no-vault llm-service'"
      }
    },
    "serve:no-vault": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "llm-service:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "llm-service:build:development"
        },
        "production": {
          "buildTarget": "llm-service:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "deploy:secrets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt npx tsx scripts/deploy-flyio-secrets.ts llm-service staging"
      }
    },
    "deploy-container": {
      "dependsOn": ["build", "prune", "smoke"],
      "command": "docker buildx build --platform linux/amd64 -f apps/api/llm-service/Dockerfile -t iamharryliu/llm-service:latest -t iamharryliu/llm-service:${COMMIT_SHA:-latest} --push dist/apps/api/llm-service"
    },
    "deploy": {
      "dependsOn": ["lint", "deploy-container", "deploy:secrets"],
      "command": "flyctl deploy --config ./deployment-configs/fly-configs/staging-llm-service.toml --image iamharryliu/llm-service:${COMMIT_SHA:-latest}"
    },
    "deploy:render:secrets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt npx tsx scripts/deploy-render.ts secrets llm-service staging"
      }
    },
    "deploy:render": {
      "dependsOn": ["lint", "deploy-container", "deploy:render:secrets"],
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt npx tsx scripts/deploy-render.ts deploy llm-service staging"
      }
    },
    "deploy:secrets:production": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_EXTRA_CA_CERTS=./scripts/vault-ca.crt npx tsx scripts/deploy-flyio-secrets.ts llm-service production"
      }
    },
    "deploy:production": {
      "dependsOn": ["lint", "deploy-container", "deploy:secrets:production"],
      "command": "flyctl deploy --config ./deployment-configs/fly-configs/production-llm-service.toml --image iamharryliu/llm-service:${COMMIT_SHA:-latest}"
    }
  }
}
