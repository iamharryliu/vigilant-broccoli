# Vault keys `pnpm logs:shipper:deploy` reads (no values here).
# FLY_LOG_SHIPPER_ACCESS_TOKEN: `flyctl tokens create readonly -o personal`, stored by hand.
# LOKI_PUSH_PASSWORD: Terraform-minted (random_password.loki_push_password), synced by tf:post-apply.
FLY_LOG_SHIPPER_ACCESS_TOKEN=
LOKI_PUSH_PASSWORD=
