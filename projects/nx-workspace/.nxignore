# Paths Nx should skip when building its project graph.
# The fly deploy chain (copy-workspace-modules) writes project.json files into
# dist/<svc>/workspace_modules/@vigilant-broccoli/*/. Without this ignore, Nx
# sees them as duplicate project definitions and refuses to build (notably hit
# during Vercel builds, where dist/ from the prior fly step is still present).
dist
tmp
# Prettier refuses an explicitly passed symbolic link, and `nx format` skips
# paths in .nxignore as well as .gitignore. The AGENTS.md agent adapters are
# tracked symlinks, so they are ignored here, not in .gitignore, where
# `git add -A` would skip a new one and fail the agent-adapter check.
AGENTS.md
