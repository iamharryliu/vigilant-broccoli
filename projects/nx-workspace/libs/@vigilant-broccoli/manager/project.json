{
  "name": "@vigilant-broccoli/manager",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/@vigilant-broccoli/manager/src",
  "projectType": "library",
  "tags": ["type:util", "visibility:private"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/@vigilant-broccoli/manager",
        "main": "libs/@vigilant-broccoli/manager/src/index.ts",
        "tsConfig": "libs/@vigilant-broccoli/manager/tsconfig.lib.json",
        "assets": []
      },
      "dependsOn": ["^build", "generate-agentic-workflows"],
      "inputs": [
        "default",
        "^default",
        {
          "dependentTasksOutputFiles": "**/agentic-workflows.json"
        }
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": ["generate-agentic-workflows"]
    },
    "generate-agentic-workflows": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/generate-agentic-workflows.ts",
        {
          "runtime": "node -p \"require('crypto').createHash('sha1').update(require('fs').readFileSync('../../README.md')).digest('hex')\""
        },
        {
          "runtime": "node -p \"const fs=require('fs'),d='../../.github/workflows';require('crypto').createHash('sha1').update(fs.readdirSync(d).sort().map(f=>f+fs.readFileSync(d+'/'+f)).join()).digest('hex')\""
        }
      ],
      "outputs": ["{projectRoot}/src/lib/generated/agentic-workflows.json"],
      "options": {
        "cwd": "libs/@vigilant-broccoli/manager",
        "command": "node --import tsx scripts/generate-agentic-workflows.ts"
      }
    }
  }
}
