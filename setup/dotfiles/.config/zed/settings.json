{
  "base_keymap": "VSCode",
  "theme": "One Light",
  "buffer_font_family": "Source Code Pro",
  "buffer_font_size": 14,
  "buffer_font_weight": 500,
  "tab_size": 4,
  "soft_wrap": "editor_width",
  "minimap": { "show": "never" },
  "autosave": { "after_delay": { "milliseconds": 1000 } },
  "format_on_save": "off",
  "terminal": {
    "font_size": 14,
    "font_weight": 600,
    "detect_venv": "off"
  },
  "languages": {
    "TypeScript": { "formatter": "language_server" },
    "Python": {
      "format_on_save": "on",
      "code_actions_on_format": { "source.organizeImports.ruff": false },
      "formatter": {
        "external": {
          "command": "black",
          "arguments": ["--stdin-filename", "{buffer_path}", "-"]
        }
      }
    }
  }
}
