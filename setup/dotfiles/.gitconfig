[user]
	name = Harry Liu
	email = harryliu1995@gmail.com

[push]
	autoSetupRemote = true

[merge]
	ff = only

[core]
    ignorecase = false

[init]
	defaultBranch = main
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
# Compacts Markdown table padding on `git add` and re-aligns it on checkout
# for repos whose .gitattributes opt in (vigilant-broccoli). Not required, so
# a failing filter passes content through and the md-table-compact pre-commit
# hook catches what it left padded.
[filter "mdtable"]
	process = node \"$(git rev-parse --show-toplevel)/scripts/node/md-table-filter.mjs\"
