{
  "name": "facebook-event-scraper",
  "private": true,
  "type": "module",
  "scripts": {
    "scrape": "node scrape-facebook-events.mjs",
    "scrape:open": "node scrape-facebook-events.mjs --out events.out.json && open events.out.json",
    "sync-calendar": "node sync-google-calendar.mjs",
    "scrape:sync-calendar": "node scrape-facebook-events.mjs --out events.out.json && node sync-google-calendar.mjs events.out.json"
  },
  "dependencies": {
    "googleapis": "^154.1.0",
    "playwright": "^1.61.1"
  }
}
