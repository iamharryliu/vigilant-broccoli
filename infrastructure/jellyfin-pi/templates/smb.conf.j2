# Managed by infrastructure/jellyfin-pi/playbook.yml — edits are overwritten.
[global]
   workgroup = {{ samba_workgroup }}
   server string = {{ pi_hostname }} media
   server role = standalone server
   security = user

   # The library is the one irreplaceable thing on this host and the home LAN
   # carries guest phones and IoT devices, so the share is authenticated and
   # anonymous access is refused outright rather than mapped to a guest.
   map to guest = never
   restrict anonymous = 2

   # SMB1 has been off by default for years; pinning the floor keeps a future
   # package default from quietly re-enabling it. macOS, Windows and Linux
   # clients all negotiate SMB3.
   server min protocol = SMB3
   client min protocol = SMB3

   # LAN plus the Tailscale CGNAT range. Nothing is port-forwarded either way,
   # so this is belt-and-braces — and it documents who the share is for.
   hosts allow = 127.0.0.1 {{ samba_allowed_networks | join(' ') }}
   hosts deny = ALL

   # Debian's stock smb.conf shares printers. This host has none.
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes

   logging = file
   log file = /var/log/samba/log.%m
   max log size = 1000

   # Worth having on a box where Ethernet and USB share one USB 2.0 bus: it
   # keeps bulk reads out of userspace entirely.
   use sendfile = yes

[{{ samba_share_name }}]
   path = {{ samba_share_path }}
   comment = Jellyfin media library
   browseable = yes
   read only = no
   valid users = {{ samba_user }}
   # Every write lands as the Jellyfin service user, which owns the library
   # directory, so files arriving over the share are readable by the
   # container without a second ownership pass.
   force user = {{ jellyfin_service_user }}
   force group = {{ jellyfin_service_group }}
   create mask = 0664
   directory mask = 0775
   # macOS scatters these across any share it touches and .Spotlight-V100 in
   # particular grows without bound — on a card the library already shares
   # with Jellyfin's cache, that space matters. Jellyfin skips dotfiles, so
   # the AppleDouble ._ files not vetoed here are harmless.
   veto files = /.DS_Store/.Spotlight-V100/.TemporaryItems/.Trashes/.fseventsd/
   delete veto files = yes
