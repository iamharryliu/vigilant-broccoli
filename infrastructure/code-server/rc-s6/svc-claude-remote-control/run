#!/usr/bin/with-contenv bash
# Remote Control rejects the long-lived CLAUDE_CODE_OAUTH_TOKEN (model requests
# only), so it runs on the full-scope login kept in /config/.claude by a
# one-time `pnpm code-server:remote-control:login`. Until that exists, poll
# instead of exiting so s6 does not restart-loop.
export HOME=/config
unset CLAUDE_CODE_OAUTH_TOKEN

WORKDIR=/config/vigilant-broccoli
LOGIN_POLL_SECONDS=60

if ! s6-setuidgid abc claude auth status >/dev/null 2>&1; then
  echo "claude-remote-control: not logged in; run 'pnpm code-server:remote-control:login' once"
  sleep "$LOGIN_POLL_SECONDS"
  exit 0
fi

cd "$WORKDIR" || { sleep "$LOGIN_POLL_SECONDS"; exit 0; }
exec s6-setuidgid abc claude remote-control --name code-server --spawn worktree
