{
  "uid": "fastify-services",
  "title": "Fastify services",
  "description": "Request rate, errors and latency for the Fly Fastify services, from requestLoggerPlugin's JSON lines.",
  "tags": ["fly", "fastify"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Fly app",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "fly_app_name",
          "type": 1
        },
        "regex": "/^(staging|production)-/",
        "refresh": 2,
        "multi": true,
        "includeAll": false,
        "sort": 1,
        "current": {
          "text": ["production-vb-express"],
          "value": ["production-vb-express"]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests in range",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({fly_app_name=~\"$app\"} |= \"latency_ms\" | json [$__range]))",
          "legendFormat": "{{fly_app_name}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "stat",
      "title": "5xx rate in range",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({fly_app_name=~\"$app\"} |= \"latency_ms\" | json | status >= 500 [$__range])) / sum(count_over_time({fly_app_name=~\"$app\"} |= \"latency_ms\" | json [$__range]))",
          "legendFormat": "{{fly_app_name}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "stat",
      "title": "p95 latency in range",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "quantile_over_time(0.95, {fly_app_name=~\"$app\"} |= \"latency_ms\" | json | unwrap latency_ms | __error__=\"\" [$__range]) by (fly_app_name)",
          "legendFormat": "{{fly_app_name}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "stat",
      "title": "4xx in range",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({fly_app_name=~\"$app\"} |= \"latency_ms\" | json | status >= 400 | status < 500 [$__range]))",
          "legendFormat": "{{fly_app_name}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        },
        "overrides": []
      },
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "stat",
      "title": "Auth rejections (401/403)",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({fly_app_name=~\"$app\"} |= \"latency_ms\" | json | status=~\"401|403\" [$__range]))",
          "legendFormat": "{{fly_app_name}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "description": "API-key auth rejections. A spike usually means a leaked or rotated key, or probing.",
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "stat",
      "title": "Rate limited (429)",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({fly_app_name=~\"$app\"} |= \"latency_ms\" | json | status=\"429\" [$__range]))",
          "legendFormat": "{{fly_app_name}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (count_over_time({fly_app_name=~\"$app\"} |= \"latency_ms\" | json [$__auto]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.5, {fly_app_name=~\"$app\"} |= \"latency_ms\" | json | unwrap latency_ms | __error__=\"\" [$__auto]) by (fly_app_name)",
          "legendFormat": "p50 {{fly_app_name}}"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {fly_app_name=~\"$app\"} |= \"latency_ms\" | json | unwrap latency_ms | __error__=\"\" [$__auto]) by (fly_app_name)",
          "legendFormat": "p95 {{fly_app_name}}"
        },
        {
          "refId": "C",
          "expr": "quantile_over_time(0.99, {fly_app_name=~\"$app\"} |= \"latency_ms\" | json | unwrap latency_ms | __error__=\"\" [$__auto]) by (fly_app_name)",
          "legendFormat": "p99 {{fly_app_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "timeseries",
      "title": "5xx error rate",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (fly_app_name) (count_over_time({fly_app_name=~\"$app\"} |= \"latency_ms\" | json | status >= 500 [$__auto])) / sum by (fly_app_name) (count_over_time({fly_app_name=~\"$app\"} |= \"latency_ms\" | json [$__auto]))",
          "legendFormat": "{{fly_app_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "timeseries",
      "title": "Slowest routes (p95)",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, quantile_over_time(0.95, {fly_app_name=~\"$app\"} |= \"latency_ms\" | json | unwrap latency_ms | __error__=\"\" [$__auto]) by (route))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Grouped by Fastify route template. Lines logged before the `route` field existed, and unmatched (404) URLs, have an empty route.",
      "id": 10,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "timeseries",
      "title": "Auth rejections and rate limits",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (count_over_time({fly_app_name=~\"$app\"} |= \"latency_ms\" | json | status=~\"401|403|429\" [$__auto]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 11,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "table",
      "title": "Routes in range",
      "description": "One row per Fastify route template; empty route = unmatched URL or a line logged before the `route` field existed.",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "format": "table",
          "expr": "sum by (route) (count_over_time({fly_app_name=~\"$app\"} |= \"latency_ms\" | json [$__range]))"
        },
        {
          "refId": "B",
          "queryType": "instant",
          "format": "table",
          "expr": "sum by (route) (count_over_time({fly_app_name=~\"$app\"} |= \"latency_ms\" | json | status >= 400 [$__range]))"
        },
        {
          "refId": "C",
          "queryType": "instant",
          "format": "table",
          "expr": "quantile_over_time(0.95, {fly_app_name=~\"$app\"} |= \"latency_ms\" | json | unwrap latency_ms | __error__=\"\" [$__range]) by (route)"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "route": "Route",
              "Value #A": "Requests",
              "Value #B": "4xx/5xx",
              "Value #C": "p95 (ms)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95 (ms)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 12,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "logs",
      "title": "Errors",
      "description": "5xx request lines plus console.error output from route handlers.",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{fly_app_name=~\"$app\"} |~ `(?i)\"level\":\"error\"|error|failed`"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "id": 13,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    }
  ]
}
